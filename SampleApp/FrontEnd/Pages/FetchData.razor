@page "/"
@inject IJSRuntime JS
@inject FrontEnd.Services.AppwriteClient Appwrite
@inject NavigationManager Navigation

@if (isLoading)
{
    <div class="workspace loading-workspace" aria-busy="true" aria-label="Loading workspace">
        <header class="topbar"><div class="skeleton-bar skeleton-crumb"></div><div class="skeleton-circle"></div></header>
        <section class="hero-row skeleton-hero"><div><div class="skeleton-bar skeleton-eyebrow"></div><div class="skeleton-bar skeleton-title"></div><div class="skeleton-bar skeleton-copy"></div></div><div class="skeleton-streak"><div class="skeleton-circle"></div><div><div class="skeleton-bar skeleton-small"></div><div class="skeleton-bar skeleton-tiny"></div></div></div></section>
        <section class="skeleton-search"><div class="skeleton-bar skeleton-search-line"></div><div class="skeleton-pills"><span></span><span></span><span></span></div></section>
        <div class="skeleton-tabs"><span></span><span></span><span></span></div>
        <section class="content-grid"><div class="papers-column"><div class="skeleton-heading"><div class="skeleton-bar"></div><div class="skeleton-bar"></div></div>@for (var index = 0; index < 3; index++) { <article class="skeleton-paper"><div class="skeleton-thumb"></div><div class="skeleton-paper-copy"><div class="skeleton-bar skeleton-meta"></div><div class="skeleton-bar skeleton-paper-title"></div><div class="skeleton-bar skeleton-paper-line"></div><div class="skeleton-bar skeleton-paper-line short"></div></div><div class="skeleton-button"></div></article> }</div><aside class="activity-panel"><div class="skeleton-heading"><div class="skeleton-bar"></div><div class="skeleton-bar"></div></div>@for (var index = 0; index < 3; index++) { <div class="skeleton-activity"><span></span><div><div class="skeleton-bar"></div><div class="skeleton-bar short"></div></div></div> }</aside></section>
    </div>
}
else
{
<div class="workspace">
    <header class="topbar"><div class="breadcrumbs"><span>Workspace</span><span>/</span><strong>Discover</strong></div><div class="top-actions"><button class="toolbar-action" @onclick="OpenUpload">Upload PYQ <span>+</span></button><button class="notification-button" title="Notifications" @onclick="ToggleNotifications">!@if (unreadCount > 0) { <span class="notification-badge">@unreadCount</span> }</button><button class="top-avatar" title="Account" @onclick="OpenAccount">@UserInitials</button><button class="settings-button" title="Settings" @onclick="OpenSettings">Settings</button></div></header>
    @if (currentUser is null)
    {
        <section class="auth-strip"><div><strong>Make this workspace yours</strong><span>Sign in to upload papers and save your progress.</span></div><a href="/login">Sign in <span>-&gt;</span></a></section>
    }
    <button class="mobile-upload-action" @onclick="OpenUpload"><span>+</span> Upload PYQ</button>
    @if (!Appwrite.IsConfigured)
    {
        <div class="empty-state">Connect your Appwrite Project ID and Database ID to load the library.</div>
    }
    else if (!string.IsNullOrWhiteSpace(dataError))
    {
        <div class="empty-state">@dataError</div>
    }
    @if (showNotifications)
    {
        <section class="notification-panel"><div class="notification-panel-head"><div><span class="modal-kicker">Stay in the loop</span><h2>Notifications</h2></div><button class="close-button" @onclick="MarkNotificationsRead">Mark read</button></div><p class="notification-copy">Choose what you want to hear about. We will show related PYQ drops and practice nudges.</p><div class="interest-chips">@foreach (var interest in Interests) { <button class="interest-chip @(selectedInterests.Contains(interest) ? "active" : "")" @onclick="() => ToggleInterest(interest)">@interest <span>@(selectedInterests.Contains(interest) ? "on" : "+")</span></button> }</div><div class="notification-list">@foreach (var notification in Notifications.Take(4)) { <div class="notification-item @(notification.IsNew ? "new" : "")"><span class="notification-dot"></span><div><strong>@notification.Title</strong><p>@notification.Body</p><time>@notification.When</time></div></div> }</div><button class="browser-notification-button" @onclick="EnableBrowserNotifications">Enable phone/browser alerts</button></section>
    }
    @if (currentUser is not null)
    {
    <section class="hero-row"><div><p class="eyebrow">YOUR STUDY WORKSPACE</p><h1>Build your <span>edge.</span></h1><p class="hero-copy">Pick a paper, find your pattern, and turn every wrong answer into your next advantage.</p></div><div class="streak-card"><div class="streak-icon">@Activities.Count</div><div><strong>Recent activity</strong><span>Synced from Appwrite</span></div></div></section>
    <section class="search-panel"><div class="search-input-wrap"><span class="search-icon">/</span><input @bind="searchTerm" @bind:event="oninput" placeholder="Search by exam, subject, year, topic..." /><kbd>CTRL K</kbd></div><div class="suggestions"><span>Try searching</span><button @onclick="SearchJee">JEE Main physics</button><button @onclick="SearchUpsc">UPSC polity</button><button @onclick="SearchNeet">NEET 2024</button></div></section>
    <div class="filter-row" aria-label="Active filter: @activeTab"><div class="filter-tabs"><button class="selected" @onclick="SelectAll">All papers</button><button @onclick="SelectPracticed">Most practiced</button><button @onclick="SelectNew">New uploads</button></div><button class="filter-button">Filter <span>+</span></button></div>
    <section class="content-grid"><div class="papers-column"><div class="section-heading"><div><h2>PYQ library</h2><p>@FilteredPapers.Count() papers from Appwrite</p></div><a href="?view=all">View all <span>-&gt;</span></a></div>@foreach (var paper in FilteredPapers) { <article class="paper-card"><div class="paper-color @paper.ColorClass"><span>@paper.Code</span></div><div class="paper-main"><div class="paper-meta"><span>@paper.Course</span><span class="dot">.</span><span>@paper.Topic</span><span class="dot">.</span><span>@paper.Year</span><span class="level @paper.LevelClass">@paper.Level</span></div><h3>@paper.Title</h3><p>@paper.Description</p><div class="paper-footer"><span>@paper.Semester</span><span class="dot">.</span><span>@paper.Questions questions</span><span class="dot">.</span><span>@paper.Duration min</span></div></div><div class="paper-actions"><button class="@SaveClass(paper)" title="Save paper" @onclick="() => ToggleSave(paper)">@SaveLabel(paper)</button><button class="open-button" @onclick="() => OpenViewer(paper)">Open paper <span>-&gt;</span></button></div></article> } @if (!FilteredPapers.Any()) { <div class="empty-state">No PYQs found. Try another course, subject, semester, or year.</div> }</div><aside class="activity-panel"><div class="section-heading"><div><h2>Recent activity</h2><p>Your practice trail</p></div><a href="?view=activity">See all</a></div><div class="activity-list">@foreach (var item in Activities) { <div class="activity-item"><span class="activity-dot @item.DotClass"></span><div><strong>@item.Title</strong><span>@item.Detail</span></div><time>@item.When</time></div> }</div><div class="insight-box"><span class="insight-symbol">i</span><div><strong>Synced library</strong><p>Your list updates from Appwrite after every upload.</p></div></div></aside></section>
    }
</div>
}

@if (selectedPaper is not null) { <div class="modal-backdrop" @onclick="CloseViewer"><section class="pdf-modal" @onclick:stopPropagation><header><div><span class="modal-kicker">PDF viewer</span><h2>@selectedPaper.Title</h2></div><button class="close-button" @onclick="CloseViewer">x</button></header><div class="pdf-toolbar"><span>Stored PYQ PDF</span><div><a class="download-link" target="_blank" rel="noopener" href="@GetPaperUrl(selectedPaper)">Open / download PDF</a></div></div><div class="pdf-page"><div class="pdf-page-header"><span>PREPTUBE ARCHIVE</span><span>@selectedPaper.Exam / @selectedPaper.Year</span></div><h3>@selectedPaper.Title</h3><p class="pdf-subtitle">Section A | @selectedPaper.Topic</p><div class="pdf-rule"></div>@if (!string.IsNullOrWhiteSpace(selectedPaper.StorageFileId)) { <iframe class="stored-pdf" title="@selectedPaper.Title" src="@GetPaperUrl(selectedPaper)"></iframe> } else { <div class="empty-state">This paper has no PDF file attached.</div> }<div class="pdf-footer"><span>Appwrite Storage</span><span>@selectedPaper.Year</span></div></div></section></div> }

@if (showUploadModal)
{
    <div class="modal-backdrop" @onclick="CloseUpload"><section class="utility-modal upload-modal" @onclick:stopPropagation><header><div><span class="modal-kicker">Community library</span><h2>Upload a PYQ</h2><p>Course, subject, semester and year are required for discovery.</p></div><button class="close-button" @onclick="CloseUpload">x</button></header><form class="upload-form" @onsubmit="UploadPaper" @onsubmit:preventDefault><div class="form-grid"><label>Course<input @bind="uploadCourse" placeholder="B.Tech CSE" required /></label><label>Subject<input @bind="uploadSubject" placeholder="Data Structures" required /></label><label>Semester<input @bind="uploadSemester" placeholder="Semester 3" required /></label><label>Year<input @bind="uploadYear" type="number" min="1990" max="2035" placeholder="2025" required /></label></div><label>Paper title<input @bind="uploadTitle" placeholder="Data Structures End Semester" required /></label><label>Description<textarea @bind="uploadDescription" placeholder="What does this paper cover?" rows="3" required></textarea></label><div class="form-grid"><label>Questions<input @bind="uploadQuestions" type="number" min="1" placeholder="30" required /></label><label>Duration (minutes)<input @bind="uploadDuration" type="number" min="1" placeholder="60" required /></label></div><label>Difficulty<select @bind="uploadLevel"><option>Advanced</option><option>Moderate</option><option>Starter</option></select></label><div class="upload-dropzone"><strong>Choose the PYQ PDF</strong><InputFile OnChange="SelectPdf" accept="application/pdf" /><span>@(selectedPdf?.Name ?? "Tap here to choose a PDF, up to 50 MB")</span></div>@if (isUploading) { <div class="upload-progress" role="status"><span class="upload-progress-bar"></span><strong>@uploadStatus</strong><small>Saving directly to Appwrite</small></div> } @if (!string.IsNullOrWhiteSpace(uploadError)) { <p class="upload-error">@uploadError</p> }<div class="modal-actions"><button type="button" class="secondary-button" @onclick="CloseUpload">Cancel</button><button type="submit" class="primary-button" disabled="@isUploading">@(isUploading ? uploadStatus : "Upload to library")</button></div></form></section></div>
}

@if (showAccountModal)
{
    <div class="modal-backdrop" @onclick="CloseAccount"><section class="utility-modal compact-modal" @onclick:stopPropagation><header><div><span class="modal-kicker">Your profile</span><h2>@(currentUser?.Name ?? "Account")</h2><p>@(currentUser?.Email ?? "Sign in to view your account")</p></div><button class="close-button" @onclick="CloseAccount">x</button></header><div class="profile-summary"><div class="large-avatar">@UserInitials</div><div><strong>@(currentUser is null ? "Not signed in" : "Connected to Appwrite")</strong><span>@Papers.Count papers available</span><span>@Activities.Count recent activities</span></div></div><div class="account-stats"><div><strong>@Papers.Count</strong><span>Available papers</span></div><div><strong>@Activities.Count</strong><span>Activities</span></div><div><strong>@savedPapers.Count</strong><span>Saved papers</span></div></div>@if (currentUser is not null) { <button class="secondary-button" @onclick="SignOut">Sign out</button> }</section></div>
}

@if (showSettingsModal)
{
    <div class="modal-backdrop" @onclick="CloseSettings"><section class="utility-modal compact-modal" @onclick:stopPropagation><header><div><span class="modal-kicker">Preferences</span><h2>Settings</h2><p>Personalize your study workspace.</p></div><button class="close-button" @onclick="CloseSettings">x</button></header><div class="settings-list"><label><span><strong>Daily reminders</strong><small>Get a gentle nudge for your practice goal.</small></span><input type="checkbox" checked /></label><label><span><strong>Show answer insights</strong><small>Display learning patterns in activity.</small></span><input type="checkbox" checked /></label><label><span><strong>Compact paper cards</strong><small>Fit more PYQs on the screen.</small></span><input type="checkbox" /></label></div></section></div>
}

@code {
    private bool isLoading = true;
    private bool showUploadModal;
    private bool showAccountModal;
    private bool showSettingsModal;
    private bool showNotifications;
    private string dataError = string.Empty;
    private FrontEnd.Services.AppwriteUser? currentUser;
    private string searchTerm = string.Empty;
    private string activeTab = "All papers";
    private string uploadExam = string.Empty;
    private string uploadCourse = string.Empty;
    private string uploadSubject = string.Empty;
    private string uploadSemester = string.Empty;
    private string uploadYear = string.Empty;
    private string uploadTitle = string.Empty;
    private string uploadDescription = string.Empty;
    private string uploadQuestions = string.Empty;
    private string uploadDuration = string.Empty;
    private string uploadLevel = "Moderate";
    private IBrowserFile? selectedPdf;
    private string uploadError = string.Empty;
    private string uploadStatus = "Uploading PDF...";
    private bool isUploading;
    private readonly List<string> Interests = ["Physics", "Biology", "Polity", "Mathematics"];
    private readonly HashSet<string> selectedInterests = ["Physics"];
    private readonly List<NotificationItem> Notifications = [];
    private int unreadCount;
    private Paper? selectedPaper;
    private readonly HashSet<string> savedPapers = [];
    private List<Paper> Papers { get; } = [];
    private List<Activity> Activities { get; } = [];
    private string UserInitials => string.IsNullOrWhiteSpace(currentUser?.Name) ? "?" : string.Concat(currentUser.Name.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(part => part[0])).ToUpperInvariant();
    private IEnumerable<Paper> FilteredPapers => Papers.Where(p => string.IsNullOrWhiteSpace(searchTerm) || $"{p.Exam} {p.Year} {p.Title} {p.Topic}".Contains(searchTerm, StringComparison.OrdinalIgnoreCase));
    private void SetSearch(string value) => searchTerm = value;
    private void SearchJee() => SetSearch("JEE Main physics");
    private void SearchUpsc() => SetSearch("UPSC polity");
    private void SearchNeet() => SetSearch("NEET 2024");
    private void SelectAll() => activeTab = "All papers";
    private void SelectPracticed() => activeTab = "Most practiced";
    private void SelectNew() => activeTab = "New uploads";
    private bool IsSaved(Paper paper) => savedPapers.Contains(paper.Title);
    private string SaveClass(Paper paper) => IsSaved(paper) ? "save-button is-saved" : "save-button";
    private string SaveLabel(Paper paper) => IsSaved(paper) ? "Saved" : "Save";
    private void ToggleSave(Paper paper) { if (!savedPapers.Add(paper.Title)) savedPapers.Remove(paper.Title); }
    private void OpenViewer(Paper paper) => selectedPaper = paper;
    private void CloseViewer() => selectedPaper = null;
    private string GetPaperUrl(Paper paper) => string.IsNullOrWhiteSpace(paper.StorageFileId) ? "#" : Appwrite.GetFileViewUrl(paper.StorageFileId);
    private void OpenUpload()
    {
        if (currentUser is null)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        uploadError = string.Empty;
        showUploadModal = true;
    }
    private void CloseUpload() { if (!isUploading) showUploadModal = false; }
    private void SelectPdf(InputFileChangeEventArgs args)
    {
        selectedPdf = args.File;
        uploadError = selectedPdf.Size > 50 * 1024 * 1024 ? "PDF must be smaller than 50 MB." : string.Empty;
    }
    private void OpenAccount()
    {
        if (currentUser is null)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        showAccountModal = true;
    }
    private void CloseAccount() => showAccountModal = false;
    private void OpenSettings() => showSettingsModal = true;
    private void CloseSettings() => showSettingsModal = false;
    private void ToggleNotifications() => showNotifications = !showNotifications;
    private void MarkNotificationsRead()
    {
        unreadCount = 0;
        for (var index = 0; index < Notifications.Count; index++)
        {
            Notifications[index] = Notifications[index] with { IsNew = false };
        }
    }
    private async Task ToggleInterest(string interest)
    {
        if (!selectedInterests.Add(interest))
        {
            selectedInterests.Remove(interest);
            return;
        }

        Notifications.Insert(0, new NotificationItem($"{interest} alert enabled", $"You will now see new {interest} PYQs and practice updates.", "Just now", true));
        unreadCount++;
        await JS.InvokeVoidAsync("prepTubeNotifications.show", $"{interest} updates enabled", $"New {interest} PYQs will appear in PYQ Parking.");
    }
    private async Task EnableBrowserNotifications() => await JS.InvokeVoidAsync("prepTubeNotifications.enable");
    private async Task UploadPaper()
    {
        if (currentUser is null)
        {
            uploadError = "Please sign in before uploading a PYQ.";
            return;
        }

        if (selectedPdf is null || selectedPdf.Size > 50 * 1024 * 1024)
        {
            uploadError = "Choose a PDF smaller than 50 MB before uploading.";
            return;
        }

        isUploading = true;
        uploadError = string.Empty;
        uploadStatus = "Uploading PDF to Appwrite Storage...";
        var levelClass = uploadLevel.ToLowerInvariant();
        var code = string.IsNullOrWhiteSpace(uploadExam) ? "P" : uploadExam[..1].ToUpperInvariant();

        try
        {
            var file = await Appwrite.UploadPdfAsync(selectedPdf);
            if (file is null)
            {
                uploadError = Appwrite.LastError ?? "The PDF could not be uploaded to Appwrite Storage.";
                return;
            }

            uploadStatus = "Saving PYQ metadata...";
            var paper = new Paper(uploadExam, uploadCourse, uploadYear, uploadSemester, uploadTitle, uploadDescription, uploadSubject, uploadQuestions, uploadDuration, code, "blue", uploadLevel, levelClass, file.Id);
            var created = await Appwrite.CreateDocumentAsync(Appwrite.PapersCollectionId, new
            {
                exam = paper.Exam,
                course = paper.Course,
                year = paper.Year,
                semester = paper.Semester,
                title = paper.Title,
                description = paper.Description,
                topic = paper.Topic,
                questions = paper.Questions,
                duration = paper.Duration,
                code = paper.Code,
                colorClass = paper.ColorClass,
                level = paper.Level,
                levelClass = paper.LevelClass,
                storageFileId = paper.StorageFileId,
                storageFileName = file.Name
            });

            if (!created)
            {
                uploadError = Appwrite.LastError ?? "The paper could not be saved to Appwrite.";
                return;
            }

            Papers.Insert(0, paper);
            searchTerm = uploadSubject;
            CloseUpload();
            uploadExam = uploadCourse = uploadSubject = uploadSemester = uploadYear = uploadTitle = uploadDescription = uploadQuestions = uploadDuration = string.Empty;
            selectedPdf = null;
        }
        catch (HttpRequestException)
        {
            uploadError = "Appwrite rejected the upload. Check login, Storage permissions, and collection attributes.";
        }
        catch (OperationCanceledException)
        {
            uploadError = "Upload timed out after 45 seconds. Check your connection and try again.";
        }
        catch (Exception exception)
        {
            uploadError = $"Upload failed: {exception.Message}";
        }
        finally
        {
            isUploading = false;
        }
    }

    private async Task SignOut()
    {
        await Appwrite.SignOutAsync();
        currentUser = null;
        CloseAccount();
    }

    private async Task LoadWorkspaceAsync()
    {
        if (!Appwrite.IsConfigured)
        {
            isLoading = false;
            return;
        }

        try
        {
            await Appwrite.InitializeAsync();
            currentUser = await Appwrite.GetCurrentUserAsync();
            var paperDocuments = await Appwrite.ListDocumentsAsync(Appwrite.PapersCollectionId);
            var activityDocuments = await Appwrite.ListDocumentsAsync(Appwrite.ActivitiesCollectionId);
            Papers.AddRange(paperDocuments.Select(MapPaper));
            Activities.AddRange(activityDocuments.Select(MapActivity));
        }
        catch (HttpRequestException)
        {
            dataError = "Unable to load Appwrite data. Check the project ID, database ID, and collection permissions.";
        }
        catch (Exception exception)
        {
            dataError = $"Workspace setup error: {exception.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private static Paper MapPaper(FrontEnd.Services.AppwriteDocument document)
    {
        var data = document.Data;
        var exam = ReadString(data, "exam");
        var title = ReadString(data, "title");
        var level = ReadString(data, "level", "Moderate");
        return new Paper(exam, ReadString(data, "course"), ReadString(data, "year"), ReadString(data, "semester"), title, ReadString(data, "description"), ReadString(data, "topic"), ReadString(data, "questions"), ReadString(data, "duration"), ReadString(data, "code", exam.Length > 0 ? exam[..1].ToUpperInvariant() : "P"), ReadString(data, "colorClass", "blue"), level, ReadString(data, "levelClass", level.ToLowerInvariant()), ReadString(data, "storageFileId"));
    }

    private static Activity MapActivity(FrontEnd.Services.AppwriteDocument document)
    {
        var data = document.Data;
        return new Activity(ReadString(data, "title"), ReadString(data, "detail"), ReadString(data, "when", "Recently"), ReadString(data, "dotClass", "blue"));
    }

    private static string ReadString(IReadOnlyDictionary<string, object?> data, string key, string fallback = "")
    {
        if (!data.TryGetValue(key, out var value) || value is null)
        {
            return fallback;
        }

        return value is System.Text.Json.JsonElement element
            ? element.ToString()
            : Convert.ToString(value) ?? fallback;
    }

    protected override async Task OnInitializedAsync() => await LoadWorkspaceAsync();

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            StateHasChanged();
        }
    }
    private record Paper(string Exam, string Course, string Year, string Semester, string Title, string Description, string Topic, string Questions, string Duration, string Code, string ColorClass, string Level, string LevelClass, string? StorageFileId = null);
    private record Activity(string Title, string Detail, string When, string DotClass);
    private record NotificationItem(string Title, string Body, string When, bool IsNew);
}
